# 图语者 DwgMind —— 大模型配置模板
#
# 用法：把本文件复制为 llm.local.env，填入你自己的 API Key 即可启用大模型增强。
#       不配置也能完整运行（自动降级为纯规则引擎）。
#
# 支持的服务商（均为 OpenAI 兼容协议）：
#   DeepSeek    : https://api.deepseek.com                          model: deepseek-chat
#   阿里云百炼   : https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-plus

LLM_ENABLED=true
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
